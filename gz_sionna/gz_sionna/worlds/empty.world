<?xml version="1.0" ?>
<sdf version='1.7'>
  <world name='default'>

    <!--
      障害物の無い平らなワールド。地面と太陽だけ。

        ros2 launch gz_sionna jetbot_tellus.launch.py world:=empty.world

      tellus3.world は Tellus のビルそのもので、tellus.dae をそのまま衝突形状に
      しているため柱も什器も全部当たる。ロボットの挙動だけを見たいとき、学習の
      挙動を切り分けたいとき、別のロボットを持ち込んだ最初の確認には、ぶつかる
      ものが無い方がよい。

      ROS 1 / Gazebo Classic 時代のこのファイルは Harmonic では開けなかった。
      SDF 1.4 で、Harmonic が要求するシステムプラグインを 1 つも読んでおらず、
      model://sun と model://ground_plane という Classic のモデルデータベース
      前提の include を持ち、さらに #6 で欠損している model://cross_line と
      model://road_model を include していた。中身を書き直してある。

      world 名は 'default' のまま変えていない。gz_world_control.py が
      /world/default/set_pose と /world/default/control を叩くので、名前を
      変えると GazeboEnv の reset が通らなくなる。

      プラグイン構成と physics は tellus3.world と揃えてある。
    -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <!-- 下げると車輪が滑って前に進まなくなる -->
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
    </model>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>1</shadows>
      <grid>true</grid>
    </scene>
    <wind/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

  </world>
</sdf>
