<?xml version="1.0"?>
<model>
  <name>radio_tower_</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <description>
    無線送信点に置かれる電波塔。world が model://radio_tower_ を参照している
    が上流に model.config / model.sdf が無かったため、同梱の
    models/tower/radio_tower.obj から復元したもの。名前末尾のアンダースコアは
    world 側の参照に合わせている。
  </description>
</model>
