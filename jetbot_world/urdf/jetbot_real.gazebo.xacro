<?xml version="1.0"?>
<!--
  Gazebo Harmonic (gz-sim 8) 向けの拡張。

  Gazebo Classic 版からの主な変更:

  - libgazebo_ros_diff_drive.so       -> gz::sim::systems::DiffDrive
  - libgazebo_ros_imu.so              -> <sensor type="imu"> + world 側の Imu システム
  - libgazebo_ros_laser.so            -> <sensor type="gpu_lidar"> + world 側の Sensors システム
  - libgazebo_ros_camera.so           -> <sensor type="camera"> + world 側の Sensors システム
  - <material>Gazebo/Green</material> -> 削除。jetbot_real.urdf.xacro 側が
                                         <color rgba> を持っており、sdformat の
                                         URDF パーサがそれを SDF の <material> に
                                         変換するため、指定しなくても色は残る

  センサ値は gz-transport に出るので、ROS 2 側へは ros_gz_bridge を通す。
  トピック名は Python 側 (gazebo_env.py) が購読している cmd_vel / odom /
  image_raw2 に合わせてあるので、bridge を同名で張れば Python 側は無改修で動く。
-->
<robot name="jetbot_real_sim" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="laser_visual" default="false"/>
  <xacro:arg name="imu_visual"   default="false"/>

  <!-- ===================== 接触パラメータ ===================== -->
  <!-- mu1 / mu2 / kp / kd は sdformat の URDF パーサが
       <surface><friction> と <contact> に変換するため、Harmonic でも有効。 -->

  <gazebo reference="wheel_left_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>500000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="wheel_right_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>500000.0</kp>
    <kd>10.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="caster_back_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <gazebo reference="caster_front_link">
    <mu1>0.1</mu1>
    <mu2>0.1</mu2>
    <kp>1000000.0</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>1.0</maxVel>
  </gazebo>

  <!-- ===================== 差動二輪駆動 ===================== -->
  <!--
    Classic の libgazebo_ros_diff_drive.so からの対応:

      commandTopic    -> topic
      odometryTopic   -> odom_topic
      odometryFrame   -> odom_frame
      robotBaseFrame  -> child_frame_id
      wheelSeparation -> wheel_separation
      wheelDiameter   -> wheel_radius   ★直径ではなく半径。0.066 -> 0.033
      leftJoint       -> left_joint
      rightJoint      -> right_joint

    publishWheelTF / legacyMode / rosDebugLevel / odometrySource /
    publishWheelJointState は Harmonic に対応する設定がないので削除した。
    車輪の関節状態は下の JointStatePublisher が出す。

    wheel_separation は URDF の車輪取り付け位置から 0.0796 * 2 = 0.1592 m。
    Classic 版は 0.160 と書かれていたので実測値に合わせた。
  -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.1592</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <topic>cmd_vel</topic>
      <!-- DiffDrive の odom は車輪エンコーダの積分なので spawn 位置からの
           相対値になる。ワールド座標が必要なので /odom は下の
           OdometryPublisher に任せ、こちらは別トピックに逃がす。 -->
      <odom_topic>wheel_odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>$(arg botname)/odom</frame_id>
      <child_frame_id>$(arg botname)/base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <!-- Classic の libgazebo_ros_diff_drive にあった
         <odometrySource>world</odometrySource> の代替。

         gz-sim の DiffDrive は車輪積分のみで、ワールド座標を出す設定がない。
         一方 gazebo_env.py は /odom の値をコースとの照合に使っており
         (_find_nearest_point で max_deviation=0.5 m と比較)、相対値のままだと
         常に「経路外」と判定されて毎 step reward=-100 / truncated=True になる。

         OdometryPublisher はモデルのワールド姿勢から odometry を作るので、
         Classic の odometrySource=world と同じ意味になる。 -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>$(arg botname)/odom</odom_frame>
      <robot_base_frame>$(arg botname)/base_footprint</robot_base_frame>
      <odom_topic>odom</odom_topic>
      <odom_publish_frequency>30</odom_publish_frequency>
      <!-- 差動二輪なので 2 次元 (x, y, yaw) で十分。 -->
      <dimensions>2</dimensions>
    </plugin>

    <!-- 車輪を含む全関節の状態を /joint_states 相当に出す。
         Classic の publishWheelJointState の代わり。 -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  <!-- ===================== IMU ===================== -->
  <!-- Classic の libgazebo_ros_imu.so は削除。Harmonic では <sensor type="imu">
       を置き、world 側の gz::sim::systems::Imu が処理する。
       ノイズ指定は Classic 版の値をそのまま移した。 -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>$(arg imu_visual)</visualize>
      <topic>imu</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev>
             <bias_mean>0.0000075</bias_mean><bias_stddev>0.0000008</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev>
             <bias_mean>0.0000075</bias_mean><bias_stddev>0.0000008</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>2e-4</stddev>
             <bias_mean>0.0000075</bias_mean><bias_stddev>0.0000008</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev>
             <bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev>
             <bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev>
             <bias_mean>0.1</bias_mean><bias_stddev>0.001</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ===================== メインカメラ ===================== -->
  <!--
    C-JEPA の観測はこのカメラから取る。gazebo_env.py が image_raw2 を
    購読しているので、トピック名を合わせてある。

    Classic の libgazebo_ros_camera.so 固有の設定 (imageTopicName,
    cameraInfoTopicName, frameName, hackBaseline, distortionK1..T2,
    alwaysOn, updateRate) は Harmonic では使わない。トピックは <topic>、
    座標系はリンク名から決まる。レンズ歪みが必要なら SDF の
    <lens><type>custom</type> で別途表現する。
  -->
  <gazebo reference="camera2_link">
    <sensor name="camera2" type="camera">
      <always_on>true</always_on>
      <update_rate>30.0</update_rate>
      <visualize>false</visualize>
      <topic>image_raw2</topic>
      <camera name="main_camera">
        <horizontal_fov>2.83</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>100.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.001</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- ===================== LiDAR ===================== -->
  <!-- Classic の ray + libgazebo_ros_laser.so を gpu_lidar に置き換えた。
       走査パラメータは Classic 版の値をそのまま移している。 -->
  <gazebo reference="base_scan">
    <sensor name="lds_lfcd_sensor" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>5</update_rate>
      <visualize>$(arg laser_visual)</visualize>
      <topic>scan</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>1147</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.28319</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.120</min>
          <max>12</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

</robot>
