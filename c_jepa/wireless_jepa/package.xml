<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wireless_jepa</name>
  <version>0.0.0</version>
  <description>Wireless-JEPA。Sionna RT の CSI からチャネル表現を学習する</description>

  <maintainer email="icon-group@todo.todo">icon-group</maintainer>

  <!-- upstream (ICONgroupCWC/DreamerV2-Meets-Gazebo) にライセンス表記が
       ないため TODO のまま残している。著者への確認待ち。 -->
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <!-- ROS 1 の tf.transformations の後継。euler_from_quaternion と
       quaternion_from_euler のみ使用している。 -->
  <exec_depend>tf_transformations</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- torch と sionna は rosdep のキーがないため package.xml に書けない。
       requirements 側で管理する (依存刷新の issue を参照)。 -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
